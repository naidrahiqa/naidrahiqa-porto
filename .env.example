# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin (Required for admin panel access via RLS)
ADMIN_EMAIL=naidrahiqa@naidra.dev

# Resend (Optional - for contact form email delivery)
RESEND_API_KEY=re_your_api_key

# GitHub Sync (Optional - token increases rate limits for repo sync)
GITHUB_USERNAME=naidrahiqa
GITHUB_TOKEN=

# Site URL (Optional - defaults to https://naidrahiqa.vercel.app for sitemap & robots)
NEXT_PUBLIC_SITE_URL=https://naidrahiqa.vercel.app

